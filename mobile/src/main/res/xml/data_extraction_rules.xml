<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 以降のクラウドバックアップと端末間の転送から、検知ログと設定を除外する。
  allowBackup="false" は Android 12 以降の端末間転送を止めないため、こちらで明示する（MVP_DESIGN.md 10章）。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
