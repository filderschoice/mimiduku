<?xml version="1.0" encoding="utf-8"?>
<!-- 広告画面の案内パネル。OverlayController が TYPE_ACCESSIBILITY_OVERLAY で画面下部に出す。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:background="@drawable/overlay_banner_background"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/ad_panel_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp" />

    <Button
        android:id="@+id/ad_panel_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:minHeight="64dp"
        android:minWidth="120dp"
        android:background="@drawable/overlay_button_background"
        android:textColor="#FF1E3A5F"
        android:textSize="20sp" />
</LinearLayout>
